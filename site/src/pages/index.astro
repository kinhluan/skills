---
import FactorCard from "../components/FactorCard.astro";
import PathCard from "../components/PathCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, getCatalog, getManifest } from "../lib/catalog.mjs";
import { withBase } from "../lib/urls";
import { fiveFactors, learningPaths, pursuits } from "../data/editorial.mjs";

const catalog = getCatalog();
const manifest = getManifest();
const categoryCounts = new Map(
  categories.map((category) => [
    category.id,
    catalog.filter((skill) => skill.category.id === category.id).length
  ])
);
const factorMap = new Map(fiveFactors.map((factor) => [factor.id, factor]));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Kinhluan Fieldbook",
  description:
    "A living fieldbook for rigorous research, thoughtful engineering, and responsible agentic work.",
  url: "https://kinhluan.github.io/skills/",
  isPartOf: {
    "@type": "SoftwareSourceCode",
    name: "Kinhluan Skills",
    codeRepository: "https://github.com/kinhluan/skills"
  }
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Kinhluan Fieldbook · Living system v{manifest.version}</p>
        <h1>Build what <em>matters.</em></h1>
        <p class="hero__lede">
          Một cẩm nang sống cho nghiên cứu nghiêm túc, kiến trúc có thể tiến hóa và
          kỹ nghệ phần mềm đặt bằng chứng cùng quyền con người ở trung tâm.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href={withBase("/pursuits/")}>
            Điều tôi đang theo đuổi <span aria-hidden="true">→</span>
          </a>
          <a class="button button--ghost" href={withBase("/library/")}>
            Khám phá {catalog.length} skills
          </a>
        </div>
      </div>

      <aside class="hero__panel" aria-label="Ngũ Sự — năm lăng kính chiến lược">
        <div class="temple-mark" aria-hidden="true">
          <div class="temple-mark__ring"></div>
          <div class="temple-mark__center">五事</div>
          <div class="temple-mark__factor temple-mark__factor--top"><b>道</b><span>Đạo</span></div>
          <div class="temple-mark__factor temple-mark__factor--right"><b>天</b><span>Thiên</span></div>
          <div class="temple-mark__factor temple-mark__factor--bottom-right"><b>地</b><span>Địa</span></div>
          <div class="temple-mark__factor temple-mark__factor--bottom-left"><b>將</b><span>Tướng</span></div>
          <div class="temple-mark__factor temple-mark__factor--left"><b>法</b><span>Pháp</span></div>
        </div>
        <p class="hero__panel-note">
          “Trước khi hành động, hãy nhìn cùng lúc vào mục đích, thời thế, địa hình,
          con người và phương pháp.”
        </p>
      </aside>
    </div>

    <div class="shell hero__stats" aria-label="Fieldbook statistics">
      <div class="hero__stat"><strong>{catalog.length}</strong><span>Published playbooks</span></div>
      <div class="hero__stat"><strong>05</strong><span>Strategic factors</span></div>
      <div class="hero__stat"><strong>{learningPaths.length}</strong><span>Learning paths</span></div>
    </div>
  </section>

  <section class="section" aria-labelledby="five-factors-heading">
    <div class="shell">
      <div class="section-head">
        <div class="section-head__title">
          <p class="section-kicker">Ngũ Sự · Five parallel lenses</p>
          <h2 class="section-title" id="five-factors-heading">Trước khi xây, hãy xét thế.</h2>
        </div>
        <p class="section-lede">
          Ngũ Sự không phải thang điểm khoa học. Đó là năm câu hỏi buộc một quyết
          định phải lộ ra bằng chứng, giới hạn và giả định có thể đảo chiều nó.
        </p>
      </div>

      <div class="factor-grid">
        {fiveFactors.map((factor) => <FactorCard factor={factor} />)}
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="pursuits-heading">
    <div class="shell">
      <div class="section-head">
        <div class="section-head__title">
          <p class="section-kicker">Now · Building · Deepening</p>
          <h2 class="section-title" id="pursuits-heading">Work in public, without pretending it is finished.</h2>
        </div>
        <p class="section-lede">
          Pursuits là những hướng đang được thực hành và điều chỉnh — không phải
          danh sách xu hướng để sưu tầm.
        </p>
      </div>

      <div class="pursuit-preview-grid">
        {
          pursuits.slice(0, 3).map((pursuit) => (
            <article class="pursuit-card">
              <span class="status-pill">{pursuit.status}</span>
              <h3>{pursuit.title}</h3>
              <p>{pursuit.summary}</p>
              <div class="pursuit-card__factors" aria-label="Ngũ Sự factors">
                {pursuit.factors.map((id) => (
                  <span class="factor-mini" title={factorMap.get(id)?.vi}>
                    {factorMap.get(id)?.han}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <a class="text-link" href={withBase("/pursuits/")}>
        Xem toàn bộ pursuits và Strategic Temple <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section section--paper-light" aria-labelledby="library-heading">
    <div class="shell catalog-overview">
      <div>
        <p class="section-kicker">The library</p>
        <div class="catalog-number" aria-hidden="true">{catalog.length}</div>
        <p>
          Mỗi skill là một field note có thể gọi trực tiếp, được sinh từ một nguồn
          canonical và liên kết với những thực hành kế cận.
        </p>
      </div>

      <div>
        <h2 class="section-title" id="library-heading">Một thư viện, nhiều đường vào.</h2>
        <div class="category-list">
          {
            categories.map((category, index) => (
              <a class="category-row" href={withBase(`/library/?category=${category.id}`)}>
                <span class="category-row__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="category-row__name">{category.label}</span>
                <span class="category-row__count">{categoryCounts.get(category.id)} skills</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="paths-heading">
    <div class="shell">
      <div class="section-head">
        <div class="section-head__title">
          <p class="section-kicker">Guided practice</p>
          <h2 class="section-title" id="paths-heading">Đừng học skill đơn lẻ. Hãy đi theo một outcome.</h2>
        </div>
        <p class="section-lede">
          Các learning path sắp xếp skill thành hành trình có đầu ra rõ ràng, nhưng
          vẫn cho phép quay lại khi bằng chứng thay đổi.
        </p>
      </div>

      <div class="paths-preview">
        {learningPaths.slice(0, 3).map((path) => <PathCard path={path} />)}
      </div>

      <a class="text-link" href={withBase("/paths/")}>
        Mở tất cả learning paths <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell closing-callout">
      <h2>The fieldbook is useful only when it changes how work is done.</h2>
      <a class="button button--primary" href={withBase("/principles/")}>
        Read the principles <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
